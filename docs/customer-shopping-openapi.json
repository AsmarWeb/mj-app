            },
            "description": "ar/ar-AE for Arabic delivery labels; en/default otherwise."
          },
          {
            "name": "item",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SetQuantity"
              }
            }
          }
        },
        "description": "Sets absolute quantity; does not increment."
      },
      "delete": {
        "operationId": "removeCustomerCartItem",
        "security": [
