  "components": {
    "securitySchemes": {
      "mobileBearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "Sanctum personal access token"
      }
    },
    "schemas": {
      "Shop": {
        "type": "object",
        "nullable": true,
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          }
        }
      },
      "Product": {
        "type": "object",
        "nullable": true,
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "integer"
          },
          "slug": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "title_ar": {
            "type": "string",
            "nullable": true
          },
          "image_url": {
            "type": "string",
            "nullable": true
          },
          "currency": {
            "type": "string"
          },
          "quantity_in_stock": {
            "type": "integer"
          },
          "shipping_method": {
            "type": "string",
            "nullable": true
          },
          "shop": {
            "$ref": "#/components/schemas/Shop"
          }
        }
      },
      "Delivery": {
        "type": "object",
        "nullable": true,
        "additionalProperties": false,
        "properties": {
          "status": {
            "type": "string",
            "nullable": true
          },
          "status_label": {
            "type": "string"
          },
          "tracking_number": {
            "type": "string",
            "nullable": true
          },
          "tracking_url": {
            "type": "string",
            "nullable": true
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        }
      },
      "CartItem": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "integer"
          },
          "quantity": {
            "type": "integer"
          },
          "available": {
            "type": "boolean"
          },
          "unit_price": {
            "type": "string",
            "pattern": "^\\d+(\\.\\d{1,2})?$",
            "nullable": true
          },
          "line_total": {
            "type": "string",
            "pattern": "^\\d+(\\.\\d{1,2})?$",
            "nullable": true
          },
          "product": {
            "$ref": "#/components/schemas/Product"
          }
        }
      },
      "Basket": {
        "type": "object",
        "properties": {
          "data": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "items": {
                "type": "array",
                "maxItems": 100,
                "items": {
                  "$ref": "#/components/schemas/CartItem"
                }
              },
              "lines_count": {
                "type": "integer"
              },
              "total_quantity": {
                "type": "integer"
              },
              "currency": {
                "type": "string",
                "enum": [
                  "AED"
                ]
              },
              "subtotal": {
                "type": "string",
                "pattern": "^\\d+(\\.\\d{1,2})?$",
                "nullable": true
              },
              "has_unavailable_items": {
                "type": "boolean"
              }
            }
          }
        }
      },
      "OrderItem": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "listing_id": {
            "type": "integer",
            "nullable": true
          },
          "digital_product_id": {
            "type": "integer",
            "nullable": true
          },
          "title": {
            "type": "string"
          },
          "quantity": {
            "type": "integer"
          },
          "unit_price": {
            "type": "string",
            "pattern": "^\\d+(\\.\\d{1,2})?$"
          },
          "total": {
            "type": "string",
            "pattern": "^\\d+(\\.\\d{1,2})?$"
          }
        }
      },
      "Address": {
        "type": "object",
        "nullable": true,
        "additionalProperties": false,
        "properties": {
          "recipient_name": {
            "type": "string",
            "nullable": true
          },
          "recipient_phone": {
            "type": "string",
            "nullable": true
          },
          "country": {
            "type": "string",
            "nullable": true
          },
          "emirate": {
            "type": "string",
            "nullable": true
          },
          "city": {
            "type": "string",
            "nullable": true
          },
          "area": {
            "type": "string",
            "nullable": true
          },
          "address_line": {
            "type": "string",
            "nullable": true
          },
          "building": {
            "type": "string",
            "nullable": true
          },
          "unit": {
            "type": "string",
            "nullable": true
          },
          "landmark": {
            "type": "string",
            "nullable": true
          },
          "delivery_notes": {
            "type": "string",
            "nullable": true
          },
          "shipping_method": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "Order": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "order_number": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "payment_status": {
            "type": "string"
          },
          "currency": {
            "type": "string",
            "nullable": true
          },
          "subtotal": {
            "type": "string",
            "pattern": "^\\d+(\\.\\d{1,2})?$"
          },
          "shipping": {
            "type": "string",
            "pattern": "^\\d+(\\.\\d{1,2})?$"
          },
          "tax": {
            "type": "string",
            "pattern": "^\\d+(\\.\\d{1,2})?$"
          },
          "discount": {
            "type": "string",
            "pattern": "^\\d+(\\.\\d{1,2})?$"
          },
          "total": {
            "type": "string",
            "pattern": "^\\d+(\\.\\d{1,2})?$"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "paid_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "shop": {
            "$ref": "#/components/schemas/Shop"
          },
          "delivery": {
            "$ref": "#/components/schemas/Delivery"
          }
        }
      },
      "OrderDetail": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Order"
          },
          {
            "type": "object",
            "properties": {
              "items": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/OrderItem"
                }
              },
              "shipping_address": {
                "$ref": "#/components/schemas/Address"
              }
            }
          }
        ]
      },
      "OrderResponse": {
        "type": "object",
        "properties": {
          "data": {
            "$ref": "#/components/schemas/OrderDetail"
          }
        }
      },
      "DeliveryResponse": {
        "type": "object",
        "properties": {
          "data": {
            "$ref": "#/components/schemas/Delivery"
          }
        }
      },
      "OrderPage": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "maxItems": 50,
            "items": {
              "$ref": "#/components/schemas/Order"
            }
          },
          "links": {
            "type": "object"
          },
          "meta": {
            "type": "object",
            "properties": {
              "current_page": {
                "type": "integer"
              },
              "per_page": {
                "type": "integer"
              },
              "total": {
                "type": "integer"
              },
              "last_page": {
                "type": "integer"
              }
            }
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          },
          "errors": {
            "type": "object"
          }
        }
      },
      "AddItem": {
        "type": "object",
        "required": [
          "listing_id",
          "quantity"
        ],
        "properties": {
          "listing_id": {
            "type": "integer",
            "minimum": 1
          },
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 99
          }
        }
      },
      "SetQuantity": {
        "type": "object",
        "required": [
          "quantity"
        ],
        "properties": {
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 99
          }
        }
      }
    }
  }
}
