{
  "openapi": "3.0.3",
  "info": {
    "title": "murwaj native customer shopping API",
    "version": "1.0.0",
    "description": "Owned cart mutations plus read-only orders and saved Raslo delivery. Requires existing mobile:account token. No payment/delivery creation endpoints."
  },
  "servers": [
    {
      "url": "https://example.test",
      "description": "Replace with Laravel HTTPS origin."
    }
  ],
  "paths": {
    "/api/v1/cart": {
      "get": {
        "operationId": "showCustomerCart",
        "security": [
          {
            "mobileBearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Basket"
                }
              }
            }
          },
          "401": {
            "description": "Missing/invalid/expired token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Explicit mobile:account ability required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Unavailable or not owned",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Validation/availability/mobile line limit",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "Accept-Language",
            "in": "header",
            "schema": {
              "type": "string"
            },
            "description": "ar/ar-AE for Arabic delivery labels; en/default otherwise."
          }
        ]
      },
      "delete": {
        "operationId": "clearCustomerCart",
        "security": [
          {
            "mobileBearer": []
          }
        ],
        "responses": {
          "204": {
            "description": "Success"
          },
          "401": {
            "description": "Missing/invalid/expired token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Explicit mobile:account ability required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
