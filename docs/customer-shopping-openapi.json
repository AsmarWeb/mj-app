              }
            },
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "Accept-Language",
            "in": "header",
            "schema": {
              "type": "string"
            },
            "description": "ar/ar-AE for Arabic delivery labels; en/default otherwise."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddItem"
              }
            }
          }
        },
        "description": "Adds quantity; not idempotent across repeated POST requests. Refresh the basket after an uncertain network result."
      }
    },
    "/api/v1/cart/items/{item}": {
      "patch": {
        "operationId": "setCustomerCartItemQuantity",
        "security": [
