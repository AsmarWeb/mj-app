                }
              }
            }
          }
        },
        "parameters": [
          {
            "in": "header",
            "name": "Accept-Language",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "order",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
