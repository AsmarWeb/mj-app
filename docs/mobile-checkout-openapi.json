          }
        ]
      }
    },
    "/api/v1/checkout/{order}/cancel": {
      "post": {
        "operationId": "expireNativeCheckout",
        "security": [
          {
            "mobileBearer": []
          }
        ],
        "description": "Verified email and explicit mobile:account token required. Physical AED/UAE only. Payment status comes from Stripe, not the caller.",
        "responses": {
          "200": {
            "description": "Created/replayed/open/closed attempt state; inspect payment_status and checkout_url.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/State"
                }
              }
            }
          },
          "401": {
            "description": "Invalid/expired token",
            "content": {
