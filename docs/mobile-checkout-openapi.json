{
  "openapi": "3.0.3",
  "info": {
    "title": "murwaj native physical checkout",
    "version": "1.0.0",
    "description": "Keyed hosted Stripe checkout backed by existing Laravel inventory/payment services. See mobile-checkout.md for retry, return-link and operational boundaries."
  },
  "servers": [
    {
      "url": "https://example.test",
      "description": "Replace with Laravel HTTPS origin."
    }
  ],
  "paths": {
    "/api/v1/checkout": {
      "post": {
        "operationId": "startNativeCheckout",
        "security": [
          {
            "mobileBearer": []
          }
        ],
        "description": "Verified email and explicit mobile:account token required. Physical AED/UAE only. Payment status comes from Stripe, not the caller.",
        "responses": {
          "200": {
            "description": "Created/replayed/open/closed attempt state; inspect payment_status and checkout_url.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/State"
                }
              }
            }
          },
          "401": {
            "description": "Invalid/expired token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Verified email and explicit mobile ability required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Unavailable or not an owned mobile-channel physical checkout",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Idempotency conflict, missing session or reconciliation required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Invalid address, key, cart, stock, store membership or closed resumption",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Checkout rate limit",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "503": {
            "description": "Stripe unavailable: recover original attempt, never start another payment",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "in": "header",
            "name": "Accept-Language",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Persist one UUID per intended purchase and reuse it with the same normalized address/store on retry."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CheckoutAddress"
              }
            }
          }
        }
      }
    },
