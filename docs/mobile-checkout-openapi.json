    "/api/mobile/checkout/return/{order}/{outcome}": {
      "get": {
        "operationId": "nativeCheckoutNavigationBridge",
        "security": [],
        "description": "Stateless signed navigation hint. No order details or payment authority; button uses fixed murwaj://checkout/result destination.",
        "parameters": [
          {
            "in": "path",
            "name": "order",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "in": "path",
            "name": "outcome",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "returned",
                "closed"
              ]
            }
          },
          {
            "in": "query",
            "name": "expires",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "signature",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Bilingual app-return page",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "403": {
            "description": "Invalid/expired signature"
          },
          "429": {
            "description": "IP rate limit"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "mobileBearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "Sanctum personal access token"
      }
    },
    "schemas": {
      "CheckoutAddress": {
        "type": "object",
        "required": [
          "shop_id",
          "recipient_name",
          "recipient_phone",
          "emirate",
          "city",
          "area",
          "address_line",
          "building"
        ],
        "properties": {
          "shop_id": {
            "type": "integer",
            "minimum": 1
          },
          "recipient_phone": {
            "type": "string",
            "description": "UAE phone; Arabic digits/local 05 or international +971/00971 are normalized."
          },
          "emirate": {
            "type": "string",
            "enum": [
              "abu_dhabi",
              "dubai",
              "sharjah",
              "ajman",
              "umm_al_quwain",
              "ras_al_khaimah",
              "fujairah"
            ]
          },
          "recipient_name": {
            "type": "string",
            "maxLength": 120
          },
          "city": {
            "type": "string",
            "maxLength": 120
          },
          "area": {
            "type": "string",
            "maxLength": 120
          },
          "address_line": {
            "type": "string",
            "maxLength": 500,
            "minLength": 5
          },
          "building": {
            "type": "string",
            "maxLength": 120
          },
          "unit": {
            "type": "string",
            "maxLength": 60,
            "nullable": true
          },
          "landmark": {
            "type": "string",
            "maxLength": 200,
            "nullable": true
          },
          "delivery_notes": {
            "type": "string",
            "maxLength": 500,
            "nullable": true
          }
        }
      },
      "State": {
        "type": "object",
        "properties": {
          "data": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "order_id": {
                "type": "integer"
              },
              "order_number": {
                "type": "string"
              },
              "status": {
                "type": "string"
              },
              "payment_status": {
                "type": "string"
              },
              "checkout_state": {
                "type": "string",
                "nullable": true
              },
              "currency": {
                "type": "string",
                "enum": [
                  "AED"
                ]
              },
              "total": {
                "type": "string"
              },
              "checkout_url": {
                "type": "string",
                "nullable": true
              },
              "expires_at": {
                "type": "string",
                "format": "date-time",
                "nullable": true
              }
            }
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "order_id": {
            "type": "integer",
            "nullable": true
          },
          "errors": {
            "type": "object"
          }
        }
      }
    }
  }
}
