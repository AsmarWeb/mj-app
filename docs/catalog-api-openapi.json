    "parameters": {
      "q": {
        "name": "q",
        "in": "query",
        "required": false,
        "schema": {
          "type": "string",
          "maxLength": 100
        },
        "description": "Literal substring in English/Arabic product titles or shop names. %, _ and ! are literal, not wildcards. Empty q means no search."
      },
      "page": {
        "name": "page",
        "in": "query",
        "required": false,
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000,
          "default": 1
        },
        "description": "One-based page number."
      },
      "per_page": {
        "name": "per_page",
        "in": "query",
        "required": false,
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50,
          "default": 20
        },
        "description": "Page size; invalid values return 422 rather than being silently accepted."
      },
      "sort_listings": {
        "name": "sort",
        "in": "query",
        "required": false,
        "schema": {
          "type": "string",
          "enum": [
            "newest",
            "oldest",
            "price_asc",
            "price_desc"
          ],
          "default": "newest"
        },
        "description": "Price sorts cast stored string prices numerically and use ID for ties."
      },
      "sort_shops": {
        "name": "sort",
        "in": "query",
        "required": false,
        "schema": {
          "type": "string",
          "enum": [
            "newest",
            "oldest"
          ],
          "default": "newest"
        },
        "description": "Stable order by ID."
      },
      "shop_id": {
        "name": "shop_id",
        "in": "query",
        "required": false,
        "schema": {
          "type": "integer",
          "minimum": 1
        },
        "description": "Filter by public record ID; missing IDs produce an empty page."
      },
      "category_id": {
        "name": "category_id",
        "in": "query",
        "required": false,
        "schema": {
          "type": "integer",
          "minimum": 1
        },
        "description": "Filter by public record ID; missing IDs produce an empty page."
      },
      "section_id": {
        "name": "section_id",
        "in": "query",
        "required": false,
        "schema": {
          "type": "integer",
          "minimum": 1
        },
        "description": "Filter by public record ID; missing IDs produce an empty page."
      },
      "country_id": {
        "name": "country_id",
        "in": "query",
        "required": false,
        "schema": {
          "type": "integer",
          "minimum": 1
        },
        "description": "Filter by public record ID; missing IDs produce an empty page."
      },
      "state_id": {
        "name": "state_id",
        "in": "query",
        "required": false,
        "schema": {
          "type": "integer",
          "minimum": 1
        },
        "description": "Filter by public record ID; missing IDs produce an empty page."
      },
      "city_id": {
        "name": "city_id",
        "in": "query",
        "required": false,
        "schema": {
          "type": "integer",
          "minimum": 1
        },
        "description": "Filter by public record ID; missing IDs produce an empty page."
      },
      "currency": {
        "name": "currency",
        "in": "query",
        "required": false,
        "schema": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "description": "Restrict listings to this shop currency. Use it with price ranges to avoid comparing different currencies."
      },
      "in_stock": {
        "name": "in_stock",
        "in": "query",
        "required": false,
        "schema": {
          "type": "integer",
          "enum": [
            0,
            1
          ]
        },
        "description": "1 enables this filter; 0 disables it."
      },
      "verified": {
        "name": "verified",
        "in": "query",
        "required": false,
        "schema": {
          "type": "integer",
          "enum": [
            0,
            1
          ]
        },
        "description": "1 enables this filter; 0 disables it."
      },
      "min_price": {
        "name": "min_price",
        "in": "query",
        "required": false,
        "schema": {
          "type": "string",
          "pattern": "^[0-9]{1,8}(\\.[0-9]{1,2})?$"
        },
        "description": "Inclusive price bound. max_price must be >= min_price. Values are in each returned shop currency; filter by shop_id for currency-specific comparison."
      },
      "max_price": {
        "name": "max_price",
        "in": "query",
        "required": false,
        "schema": {
          "type": "string",
          "pattern": "^[0-9]{1,8}(\\.[0-9]{1,2})?$"
        },
        "description": "Inclusive price bound. max_price must be >= min_price. Values are in each returned shop currency; filter by shop_id for currency-specific comparison."
      }
