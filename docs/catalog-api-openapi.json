{
  "openapi": "3.0.3",
  "info": {
    "title": "murwaj Public Catalog API",
    "version": "1.0.0",
    "description": "Read-only published catalog. No payment, token creation, product mutations or inventory reservation. Both English and Arabic fields are returned; descriptions are untrusted text, not sanitized HTML. Legacy /api/shops and /api/listings aliases share all guards and quotas, but new clients should use /api/v1."
  },
